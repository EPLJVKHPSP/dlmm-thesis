# Local review configuration. Do not place production secrets in this repository.
# Only set DATABASE_URL when using a configured PostgreSQL database.
# URL-encode passwords that contain URI-special characters.
# DATABASE_URL=postgres://dlmm_review:<encoded-password>@localhost:5432/dlmm_thesis
DLMM_SESSION_KEY=
# Docker Compose only: these values must agree; do not commit actual values.
DLMM_DB_PASSWORD=
DLMM_DATABASE_URL=
DLMM_SECURE_COOKIE=false
# Telegram alerts (optional). Create a bot with @BotFather, paste its token
# here, and list your chat id (message @userinfobot to learn it). Leave both
# empty and the sender stays dormant — everything else keeps working.
BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Automatic held-asset monitor interval. Minimum 15 seconds.
TELEGRAM_POLL_SECONDS=60

# Optional local review login; set to a unique secret before enabling fallback authentication.
DLMM_REVIEW_PASSWORD=
